# Copy to .kamal/secrets (gitignored). Values are read from your shell or a password manager,
# never committed. Example with environment variables:
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
APP_DB_PASSWORD=$APP_DB_PASSWORD
# The app connects as the non-superuser "app" role (RLS applies), via the kamal network.
DATABASE_URL=postgres://app:$APP_DB_PASSWORD@starter-db:5432/app
CLERK_SECRET_KEY=$CLERK_SECRET_KEY
CLERK_PUBLISHABLE_KEY=$CLERK_PUBLISHABLE_KEY
RESEND_API_KEY=$RESEND_API_KEY
S3_ACCESS_KEY_ID=$S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=$S3_SECRET_ACCESS_KEY
SENTRY_DSN=$SENTRY_DSN
