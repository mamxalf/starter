# Copy to .env and fill in. Validated at startup by apps/api/src/env.ts.
# NODE_ENV is not set here: tools set it (Vite builds use production, the API defaults to development).
PORT=3000
APP_URL=http://localhost:5173

# Postgres: the app connects as a NON-superuser so Row Level Security applies.
DATABASE_URL=postgres://app:app@localhost:5432/app
TEST_DATABASE_URL=postgres://app:app@localhost:5432/app_test

# Auth. Start with the dev provider (sign in with any email, no account needed),
# then switch both to clerk and fill the keys. api: fake | clerk, web: dev | clerk
AUTH_PROVIDER=fake
VITE_AUTH_PROVIDER=dev
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Email: smtp (Mailpit in dev, SES/any SMTP in prod) or resend
MAIL_DRIVER=smtp
MAIL_FROM="App <noreply@mail.example.com>"
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=

# Storage (any S3-compatible: R2, Garage, MinIO, S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=app
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345

# Error tracking (optional). Works with Sentry or self-hosted GlitchTip.
SENTRY_DSN=

# Platform admin back-office (apps/admin, served at /api/admin/rpc). Disabled while PLATFORM_ADMINS is empty.
# Comma-separated emails; each must be a VERIFIED email at the auth provider. Not tenant memberships.
PLATFORM_ADMINS=
# Production: hostname that serves the admin app and API (any other host gets 404), e.g. admin.example.com
ADMIN_HOST=
# Production: path of the built admin SPA (the Docker image sets /app/admin)
ADMIN_DIST=
# Optional Cloudflare Access in front of the admin host. Set both or neither.
# CF_ACCESS_TEAM_DOMAIN is <team>.cloudflareaccess.com, CF_ACCESS_AUD the Access application's AUD tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
