# Copy to .env and fill in. Validated at startup by apps/api/src/env.ts.
# NODE_ENV is not set here: tools set it (Vite builds use production, the API defaults to development).
PORT=3000
APP_URL=http://localhost:5173

# Postgres: the app connects as a NON-superuser so Row Level Security applies.
DATABASE_URL=postgres://app:app@localhost:5432/app
TEST_DATABASE_URL=postgres://app:app@localhost:5432/app_test

# Auth. Start with the dev provider (sign in with any email, no account needed),
# then switch both to clerk and fill the keys. api: fake | clerk, web: dev | clerk
AUTH_PROVIDER=fake
VITE_AUTH_PROVIDER=dev
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Email: smtp (Mailpit in dev, SES/any SMTP in prod) or resend
MAIL_DRIVER=smtp
MAIL_FROM="App <noreply@mail.example.com>"
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=

# Storage (any S3-compatible: R2, Garage, MinIO, S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=app
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345

# Error tracking (optional). Works with Sentry or self-hosted GlitchTip.
SENTRY_DSN=
