{
  "name": "ts-saas-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && turbo run typecheck test && pnpm check:boundaries",
    "check:boundaries": "turbo boundaries && node scripts/check-module-boundaries.mjs",
    "db:new": "pnpm --filter @starter/db db:new",
    "db:migrate": "pnpm --filter @starter/db db:migrate",
    "db:rollback": "pnpm --filter @starter/db db:rollback",
    "db:seed": "pnpm --filter @starter/db db:seed",
    "db:reset": "pnpm --filter @starter/db db:reset",
    "gen": "turbo gen"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@turbo/gen": "2.11.10",
    "lefthook": "2.2.2",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
